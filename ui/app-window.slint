import { Button, LineEdit, VerticalBox, HorizontalBox, ScrollView, ComboBox, Spinner, AboutSlint, Palette } from "std-widgets.slint";

component SettingsButton inherits Button {
    min-width: 112px; max-width: 112px;
    min-height: 32px; max-height: 32px;
    horizontal-stretch: 0; vertical-stretch: 0;
}

component UpdateLink inherits FocusScope {
    in property <string> text;
    in property <color> ink;
    in property <bool> active;
    callback activated();
    preferred-width: label.preferred-width;
    preferred-height: 24px;
    horizontal-stretch: 0;
    enabled: root.active;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.active { root.activated(); } }
    key-pressed(event) => {
        if root.active && (event.text == Key.Return || event.text == Key.Space) {
            root.activated();
            return accept;
        }
        return reject;
    }
    label := Text {
        text: root.text; color: root.ink; font-size: 12px; font-weight: 600;
        vertical-alignment: center;
    }
    Rectangle { y: parent.height - 3px; height: root.has-focus ? 2px : 1px; background: root.ink; }
    TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.focus(); root.activated(); }
    }
}

export component AppWindow inherits Window {
    title: "Helium DRM Fixer";
    icon: @image-url("linux/io.github.KirioDEV.HeliumDRMFixer.svg");
    preferred-width: 640px;
    preferred-height: 560px;
    min-width: 640px;
    max-width: 640px;
    min-height: 560px;
    max-height: 560px;
    background: root.dark ? #11141c : #f3f5fa;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    in-out property <bool> dark: true;
    in property <bool> busy;
    in property <bool> update-busy;
    in property <bool> inspecting;
    in property <bool> can-install;
    in property <bool> can-restore;
    in property <bool> status-valid;
    in-out property <string> target-path;
    in property <string> status-title: "Checking installation";
    in property <string> status-detail: "Reading the local Widevine status.";
    in property <string> phase;
    in property <string> app-version;
    in property <bool> update-available;
    in property <string> update-version;
    in property <string> update-status;
    // Settings contains Help, About and Updates.
    in-out property <int> page: 0;
    private property <int> confirmation: 0;
    private property <color> ink: root.dark ? #edf0fa : #172033;
    private property <color> muted: root.dark ? #a6afc3 : #58657b;
    private property <color> panel: root.dark ? #1b2030 : #ffffff;
    callback inspect();
    callback install();
    callback restore();
    callback cancel();
    callback target-edited();
    callback check-app-update();
    callback update-app();

    init => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }

    VerticalBox {
        padding: 22px;
        spacing: 16px;
        HorizontalBox {
            padding: 0px;
            VerticalBox {
                padding: 0px;
                spacing: 3px;
                Text { text: "HELIUM DRM FIXER"; color: #8e9dff; font-size: 11px; font-weight: 700; }
                Text {
                    text: root.page == 0 ? "Manage Widevine" : root.page == 1 ? "Settings" : root.page == 2 ? "Help" : root.page == 3 ? "About" : "Updates";
                    color: root.ink; font-size: 24px; font-weight: 700;
                }
            }
            Button {
                text: root.page == 0 ? "Settings" : "Back";
                max-width: 96px; height: 34px; horizontal-stretch: 0;
                enabled: root.confirmation == 0;
                clicked => { root.page = root.page == 0 ? 1 : root.page == 1 ? 0 : 1; }
            }
        }
        ScrollView {
            VerticalBox {
                padding: 0px;
                spacing: 14px;
                if root.page == 0: VerticalBox {
                    padding: 0px; spacing: 14px;
                    Rectangle {
                        background: root.status-valid ? (root.dark ? #142b24 : #edf9f1) : root.panel;
                        border-radius: 12px;
                        border-width: root.status-valid ? 1px : 0px;
                        border-color: root.dark ? #3d946e : #78b990;
                        VerticalBox {
                            padding: 16px; spacing: 7px;
                            Text {
                                text: root.status-valid ? "WIDEVINE · INSTALLED" : "WIDEVINE";
                                color: root.status-valid ? (root.dark ? #8fdbb4 : #226640) : root.muted;
                                font-size: 11px; font-weight: 600;
                            }
                            Text { text: root.status-title; color: root.ink; font-size: 22px; font-weight: 600; wrap: word-wrap; }
                            Text { text: root.status-detail; color: root.muted; wrap: word-wrap; }
                        }
                    }
                    VerticalBox {
                        padding: 0px; spacing: 7px;
                        Text { text: "Widevine folder"; color: root.ink; font-weight: 600; }
                        HorizontalBox {
                            padding: 0px;
                            LineEdit {
                                text <=> root.target-path;
                                placeholder-text: "Leave empty to detect Helium automatically";
                                enabled: !root.busy && root.confirmation == 0;
                                edited => { root.target-edited(); }
                            }
                            Button { text: "Check"; enabled: !root.busy && root.confirmation == 0; clicked => { root.inspect(); } }
                        }
                        Text { text: "For a custom location, use the exact WidevineCdm folder."; color: root.muted; font-size: 12px; wrap: word-wrap; }
                    }
                    if root.confirmation == 0: HorizontalBox {
                        padding: 0px;
                        Button {
                            text: "Install Widevine"; primary: true;
                            enabled: !root.busy && root.can-install;
                            clicked => { root.confirmation = 1; }
                        }
                        Button { text: "Restore"; enabled: !root.busy && root.can-restore; clicked => { root.confirmation = 2; } }
                    }
                    if root.confirmation != 0: Rectangle {
                        background: root.panel; border-radius: 12px;
                        VerticalBox {
                            padding: 14px; spacing: 10px;
                            Text {
                                text: root.confirmation == 1
                                    ? "Verify Widevine from Google and install it in the folder above? Your current state will be backed up."
                                    : "Restore the previous Widevine state in the folder above?";
                                color: root.ink; wrap: word-wrap;
                            }
                            Text { text: "Close Helium and Chrome completely before continuing."; color: root.muted; wrap: word-wrap; }
                            HorizontalBox {
                                Button {
                                    text: "Confirm"; primary: true;
                                    clicked => {
                                        if root.confirmation == 1 { root.install(); }
                                        else { root.restore(); }
                                        root.confirmation = 0;
                                    }
                                }
                                Button { text: "Cancel"; clicked => { root.confirmation = 0; } }
                            }
                        }
                    }
                    if (root.busy && !root.update-busy && !root.inspecting) || root.phase != "": HorizontalBox {
                        padding: 0px;
                        if root.busy && !root.update-busy && !root.inspecting: Spinner { }
                        Text { text: root.phase; color: root.muted; wrap: word-wrap; vertical-alignment: center; }
                        if root.busy && !root.update-busy && !root.inspecting: Button { text: "Cancel operation"; clicked => { root.cancel(); } }
                    }
                    Text { text: "HD playback and support for individual streaming services are not guaranteed."; color: root.muted; wrap: word-wrap; font-size: 12px; }
                }
                if root.page == 1: VerticalBox {
                    padding: 0px; spacing: 12px;
                    alignment: start;
                    Rectangle {
                        background: root.panel; border-radius: 10px;
                        height: 56px;
                        vertical-stretch: 0;
                        HorizontalBox {
                            padding: 12px;
                            Text { text: "Color theme"; color: root.ink; vertical-alignment: center; }
                            ComboBox {
                                accessible-label: "Color theme";
                                model: ["Dark", "Light"];
                                current-index: root.dark ? 0 : 1;
                                width: 132px;
                                height: 32px;
                                horizontal-stretch: 0;
                                vertical-stretch: 0;
                                selected(value) => { root.dark = self.current-index == 0; }
                            }
                        }
                    }
                    HorizontalBox {
                        padding: 0px; spacing: 8px;
                        alignment: start;
                        SettingsButton { text: "Updates"; clicked => { root.page = 4; } }
                        SettingsButton { text: "Help"; clicked => { root.page = 2; } }
                        SettingsButton { text: "About"; clicked => { root.page = 3; } }
                    }
                }
                if root.page == 2: VerticalBox {
                    padding: 0px; spacing: 14px;
                    Text { text: "Install and restore"; color: root.ink; font-size: 20px; font-weight: 600; }
                    Text {
                        text: "1. Close Helium and Chrome completely.\n2. Check the detected Widevine folder.\n3. Select Install Widevine and confirm the destination.\n4. Restart Helium and test your streaming service.\n\nTo undo the installation, close both browsers and select Restore for the same folder.";
                        color: root.muted; wrap: word-wrap;
                    }
                    Text { text: "What does Check do?"; color: root.ink; font-size: 18px; font-weight: 600; }
                    Text {
                        text: "Check only reads local files. It does not download or install anything. A valid local installation does not guarantee HD playback or compatibility with every service.";
                        color: root.muted; wrap: word-wrap;
                    }
                }
                if root.page == 3: VerticalBox {
                    padding: 0px; spacing: 14px;
                    alignment: start;
                    vertical-stretch: 0;
                    Text { text: "Helium DRM Fixer"; color: root.ink; font-size: 20px; font-weight: 600; vertical-stretch: 0; }
                    Text {
                        text: "An independent tool to verify and install Widevine with backup and restore. Not an official Helium or Google application.";
                        color: root.muted; wrap: word-wrap; vertical-stretch: 0;
                    }
                }
                if root.page == 4: VerticalBox {
                    padding: 0px; spacing: 14px; alignment: start;
                    Rectangle {
                        background: root.panel; border-radius: 12px;
                        VerticalBox {
                            padding: 16px; spacing: 10px;
                            Text { text: "Version " + root.app-version; color: root.ink; font-size: 20px; font-weight: 600; }
                            HorizontalBox {
                                padding: 0px; spacing: 8px;
                                if root.update-busy: Spinner { }
                                Text {
                                    text: root.update-status == "" ? "Check for a newer version of Helium DRM Fixer." : root.update-status;
                                    color: root.muted; wrap: word-wrap; vertical-alignment: center;
                                }
                            }
                            if root.confirmation == 0: HorizontalBox {
                                padding: 0px;
                                Button {
                                    text: "Check for updates";
                                    enabled: !root.busy;
                                    clicked => { root.check-app-update(); }
                                }
                                if root.update-available: Button {
                                    text: "Update to " + root.update-version; primary: true;
                                    enabled: !root.busy;
                                    clicked => { root.confirmation = 3; }
                                }
                            }
                        }
                    }
                    if root.confirmation == 3: Rectangle {
                        background: root.panel; border-radius: 12px;
                        VerticalBox {
                            padding: 14px; spacing: 10px;
                            Text {
                                text: "Install signed app update " + root.update-version + " and restart? The previous app version will be kept as a backup.";
                                color: root.ink; wrap: word-wrap;
                            }
                            Text { text: "Only this app is updated. Your Widevine installation stays as it is."; color: root.muted; wrap: word-wrap; }
                            HorizontalBox {
                                Button {
                                    text: "Update and restart"; primary: true;
                                    enabled: !root.busy && root.update-available;
                                    clicked => { root.confirmation = 0; root.update-app(); }
                                }
                                Button { text: "Cancel"; clicked => { root.confirmation = 0; } }
                            }
                        }
                    }
                    Text { text: "Updates are checked against stable GitHub releases and verified before installation."; color: root.muted; wrap: word-wrap; font-size: 12px; }
                    if root.update-busy: Button {
                        text: "Cancel operation";
                        clicked => { root.cancel(); }
                    }
                }
            }
        }
        if root.page == 3: HorizontalBox {
            padding: 0px;
            alignment: center;
            vertical-stretch: 0;
            AboutSlint {
                width: 280px;
                height: 112px;
                horizontal-stretch: 0;
                vertical-stretch: 0;
            }
        }
        HorizontalBox {
            padding: 0px; spacing: 8px;
            height: 24px; vertical-stretch: 0;
            Text {
                text: "Version " + root.app-version;
                color: root.muted; font-size: 12px; vertical-alignment: center;
                horizontal-stretch: 0;
            }
            Rectangle { background: transparent; }
            if root.update-available: UpdateLink {
                text: "Update available - " + root.update-version;
                ink: root.dark ? #a6b1ff : #4935d1;
                active: !root.busy && root.confirmation == 0;
                activated => { root.page = 4; }
            }
        }
    }
}
